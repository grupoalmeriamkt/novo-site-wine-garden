# =============================================================================
# WINE GARDEN — VARIÁVEIS DE AMBIENTE
# Copie para .env.local e preencha. .env.local NÃO vai para o repositório.
#
# Tudo que começa com NEXT_PUBLIC_ é embutido no JavaScript enviado ao
# navegador e portanto É PÚBLICO. Nunca coloque segredo de servidor com esse
# prefixo.
# =============================================================================


# -----------------------------------------------------------------------------
# SITE
# -----------------------------------------------------------------------------
# URL canônica de produção, sem barra final. Usada em Open Graph, canonical,
# sitemap.xml e JSON-LD. Sem ela, o build usa um fallback e as URLs absolutas
# ficam erradas.
NEXT_PUBLIC_SITE_URL=https://winegarden.com.br


# -----------------------------------------------------------------------------
# GOOGLE MAPS
# -----------------------------------------------------------------------------
# Chave da Maps JavaScript API. É uma chave de NAVEGADOR e fica visível no
# código-fonte da página — isso é esperado e documentado pelo Google. A proteção
# NÃO é esconder a chave, é restringi-la. Antes de publicar:
#
#   1. Google Cloud Console → APIs e Serviços → Credenciais → sua chave
#   2. Restrições de aplicativo → "Referenciadores HTTP (sites)"
#      Adicione APENAS os domínios reais:
#         https://winegarden.com.br/*
#         https://www.winegarden.com.br/*
#         https://*.vercel.app/*        (só enquanto usar preview deploys)
#         http://localhost:3000/*       (só em desenvolvimento)
#   3. Restrições de API → marque SOMENTE:
#         Maps JavaScript API
#         (adicione Places API apenas se vier a usar dados de lugar)
#   4. Faturamento → defina orçamento e alertas. Uma chave sem restrição de
#      referenciador pode ser copiada e usada por terceiros na sua conta.
#
# Sem esta variável a seção de localização funciona: cai no estado sem mapa,
# com endereço, horário e o botão "Como chegar" ativos.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Map ID do estilo criado no Cloud Console.
# OBRIGATÓRIO para AdvancedMarkerElement — sem ele o marcador não renderiza.
#   Google Cloud Console → Google Maps Platform → Estilos de mapa → Criar estilo
#   Sugestão de paleta para conversar com a identidade:
#     água        #C7AE9A (Bege)
#     terreno     #F7F9EA (Offwhite)
#     vias        #FFFFFF com traço #C7AE9A
#     parques     #414417 (Oliva)
#     rótulos     #3F0A25 (Uva)
#     POI         desligado, exceto o próprio estabelecimento
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=

# Place ID do estabelecimento no Google. OPCIONAL.
# Quando presente, o link "Como chegar" fica mais preciso.
#
# ⚠️ ATENÇÃO: o valor abaixo foi encontrado em um espelho público de terceiros e
# NÃO foi verificado diretamente no Google. VALIDE antes de usar em produção:
#   https://developers.google.com/maps/documentation/javascript/examples/places-placeid-finder
# Candidato a validar: ChIJxfBMVfclWpMRPGvBVFf5YxY
NEXT_PUBLIC_WINE_GARDEN_PLACE_ID=

# Coordenadas do pin. OPCIONAL — há fallback em src/data/site.ts com o par da
# ficha do Google (-15.825931, -47.871311). O GetIn publica um par ~310 m a
# oeste; ambos caem dentro do Pontão. Confirme o pin exato com a casa.
NEXT_PUBLIC_WINE_GARDEN_LAT=
NEXT_PUBLIC_WINE_GARDEN_LNG=


# -----------------------------------------------------------------------------
# CLIMA — a leitura do momento no herói
# -----------------------------------------------------------------------------
# Chave do Google Maps Platform com a **Weather API** habilitada. Alimenta a
# linha do herói: "Aberto agora — Parcialmente ensolarado, 26°" mais a sugestão
# do cardápio que varia com hora, dia e tempo.
#
# ⚠️ NOTE A AUSÊNCIA DO PREFIXO NEXT_PUBLIC_. É proposital: esta chave é lida
# APENAS no servidor, pelo route handler /api/momento. Se receber o prefixo,
# passa a ser embutida no JavaScript do navegador e qualquer pessoa pode gastar
# a cota na conta do cliente.
#
# Habilitar em: Google Cloud Console → APIs e Serviços → Ativar API → "Weather API"
# Pode ser a MESMA chave do Maps, desde que:
#   · a Weather API esteja na lista de APIs permitidas da chave, E
#   · a chave NÃO tenha restrição de referenciador HTTP — restrição de
#     referenciador quebra chamadas de servidor, que não têm referer.
#   Se a chave do Maps já está restrita por referenciador (e deve estar),
#   crie uma SEGUNDA chave para uso server-side, restrita por endereço IP.
#
# Sem esta variável nada quebra: o herói mostra data, hora de Brasília, se a
# casa está aberta e a sugestão baseada só no relógio.
GOOGLE_WEATHER_API_KEY=


# -----------------------------------------------------------------------------
# RESERVA
# -----------------------------------------------------------------------------
# URL de reserva. O padrão é a página real da casa no GetIn — só preencha para
# sobrescrever (troca de provedor, campanha, link com parâmetros).
NEXT_PUBLIC_RESERVATION_URL=


# -----------------------------------------------------------------------------
# ANALYTICS (opcional)
# -----------------------------------------------------------------------------
# Os eventos são empurrados para window.dataLayer por src/lib/analytics.ts.
# Se usar Google Tag Manager, informe o container e adicione o script no layout.
# Sem container configurado, os eventos são descartados em silêncio e nada
# quebra.
NEXT_PUBLIC_GTM_ID=
